{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!**/fixtures/**/*.xml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "big.js": "Use Decimal from src/documents/decimal.ts; it is the only file that imports big.js."
            }
          }
        }
      },
      "suspicious": {
        "noConsole": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/index.ts", "**/*.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": [
        "src/index.ts",
        "src/values.ts",
        "src/results.ts",
        "src/catalogs/index.ts",
        "src/catalogs/documents/*.ts",
        "src/testing/index.ts"
      ],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      "includes": ["src/documents/decimal.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["poc/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
